<?xml version="1.0" encoding="utf-8"?>
<!-- Compact constraint variant applied to item_reminder_item.xml's view tree.
     Date and message stay visible (message 2-line); the action container is
     moved to the row end with only the delete button visible. -->
<ConstraintSet xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Constraint
        android:id="@+id/container_action_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Constraint
        android:id="@+id/text_reminder_date_time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/text_margin"
        android:layout_marginTop="@dimen/text_margin"
        android:layout_marginEnd="@dimen/text_margin"
        android:visibility="visible"
        app:layout_constraintEnd_toStartOf="@id/container_action_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Owner chip on the delete-button row (left of the action container,
         vertically centered on it). No android:visibility here: the chip's
         visibility is data-driven (shown in global mode, GONE in per-item
         mode) and re-applied by ItemReminderItemSV's subscription after every
         applyTo. -->
    <Constraint
        android:id="@+id/chip_item_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/text_margin"
        android:layout_marginEnd="@dimen/text_margin"
        app:layout_constraintBottom_toBottomOf="@id/container_action_button"
        app:layout_constraintEnd_toStartOf="@id/container_action_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/container_action_button" />

    <Constraint
        android:id="@+id/text_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/text_margin"
        android:layout_marginEnd="@dimen/text_margin"
        android:layout_marginBottom="@dimen/text_margin"
        android:ellipsize="end"
        android:maxLines="2"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/container_action_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_reminder_date_time" />

    <!-- button_edit is nested inside container_action_button, so its visibility
         is toggled in code (ItemReminderItemSV), not here. -->
</ConstraintSet>
