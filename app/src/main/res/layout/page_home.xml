<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/container_app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    xmlns:tools="http://schemas.android.com/tools"
                    android:id="@+id/container_dashboard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_dashboard_inventory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="5dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/title_dashboard_inventory"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <com.google.android.material.textview.MaterialTextView
                                        android:id="@+id/text_dashboard_inventory_count"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="28sp"
                                        android:textStyle="bold"
                                        tools:text="2" />

                                    <com.google.android.material.textview.MaterialTextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/dashboard_items_label"
                                        android:textColor="@color/gray_700"
                                        android:textSize="12sp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <com.google.android.material.textview.MaterialTextView
                                        android:id="@+id/text_dashboard_inventory_value"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textSize="28sp"
                                        android:textStyle="bold"
                                        tools:text="20" />

                                    <com.google.android.material.textview.MaterialTextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/dashboard_total_value_label"
                                        android:textColor="@color/gray_700"
                                        android:textSize="12sp" />
                                </LinearLayout>
                            </LinearLayout>

                            <View
                                android:id="@+id/divider_dashboard_low_stock"
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="12dp"
                                android:layout_marginBottom="12dp"
                                android:background="@color/dashboard_divider" />

                            <LinearLayout
                                android:id="@+id/container_dashboard_low_stock"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:visibility="gone">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">

                                    <androidx.appcompat.widget.AppCompatImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:importantForAccessibility="no"
                                        android:src="@drawable/ic_dashboard_low_stock"
                                        android:tint="@color/dashboard_amber" />

                                    <com.google.android.material.textview.MaterialTextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:fontFamily="sans-serif-medium"
                                        android:text="@string/dashboard_low_stock_label"
                                        android:textSize="14sp" />

                                    <com.google.android.material.textview.MaterialTextView
                                        android:id="@+id/text_dashboard_low_stock_summary"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="6dp"
                                        android:textColor="@color/dashboard_amber"
                                        android:textSize="16sp"
                                        android:textStyle="bold"
                                        tools:text="1" />
                                </LinearLayout>

                                <com.google.android.material.textview.MaterialTextView
                                    android:id="@+id/text_dashboard_low_stock_samples"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="28dp"
                                    android:ellipsize="end"
                                    android:maxLines="3"
                                    android:textColor="?android:attr/textColorSecondary"
                                    android:textSize="12sp"
                                    tools:text="Milk (min 2)\nRice (min 1)" />
                            </LinearLayout>

                            <View
                                android:id="@+id/divider_dashboard_expiring"
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginTop="12dp"
                                android:layout_marginBottom="12dp"
                                android:background="@color/dashboard_divider" />

                            <LinearLayout
                                android:id="@+id/container_dashboard_expiring"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:visibility="gone">

                                <LinearLayout
                                    android:id="@+id/container_dashboard_expired_group"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:visibility="gone">

                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:gravity="center_vertical">

                                        <androidx.appcompat.widget.AppCompatImageView
                                            android:layout_width="20dp"
                                            android:layout_height="20dp"
                                            android:importantForAccessibility="no"
                                            android:src="@drawable/ic_dashboard_expired"
                                            android:tint="@color/dashboard_red" />

                                        <com.google.android.material.textview.MaterialTextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:fontFamily="sans-serif-medium"
                                            android:text="@string/dashboard_expired_label"
                                            android:textSize="14sp" />

                                        <com.google.android.material.textview.MaterialTextView
                                            android:id="@+id/text_dashboard_expiring_summary"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="6dp"
                                            android:textColor="@color/dashboard_red"
                                            android:textSize="16sp"
                                            android:textStyle="bold"
                                            tools:text="1" />
                                    </LinearLayout>

                                    <com.google.android.material.textview.MaterialTextView
                                        android:id="@+id/text_dashboard_expired_samples"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="28dp"
                                        android:ellipsize="end"
                                        android:maxLines="3"
                                        android:textColor="?android:attr/textColorSecondary"
                                        android:textSize="12sp"
                                        tools:text="Yogurt — 05 Sep" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/container_dashboard_expiring_group"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:visibility="gone">

                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:gravity="center_vertical">

                                        <androidx.appcompat.widget.AppCompatImageView
                                            android:layout_width="20dp"
                                            android:layout_height="20dp"
                                            android:importantForAccessibility="no"
                                            android:src="@drawable/ic_dashboard_expiring"
                                            android:tint="@color/dashboard_amber" />

                                        <com.google.android.material.textview.MaterialTextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="8dp"
                                            android:fontFamily="sans-serif-medium"
                                            android:text="@string/dashboard_expiring_soon_label"
                                            android:textSize="14sp" />

                                        <com.google.android.material.textview.MaterialTextView
                                            android:id="@+id/text_dashboard_expiring_soon_summary"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="6dp"
                                            android:textColor="@color/dashboard_amber"
                                            android:textSize="16sp"
                                            android:textStyle="bold"
                                            tools:text="2" />
                                    </LinearLayout>

                                    <com.google.android.material.textview.MaterialTextView
                                        android:id="@+id/text_dashboard_expiring_samples"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="28dp"
                                        android:ellipsize="end"
                                        android:maxLines="3"
                                        android:textColor="?android:attr/textColorSecondary"
                                        android:textSize="12sp"
                                        tools:text="Milk — 12 Sep" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_dashboard_reminders"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground"
                        android:visibility="gone"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="5dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/title_dashboard_reminders"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/text_dashboard_reminders_summary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                tools:text="2 upcoming" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/text_dashboard_reminders_samples"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="3"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="12sp"
                                tools:text="Check milk — 12 Sep\nWater the plants — 13 Sep" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="@integer/grid_column_count">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_add_item"
                        style="@style/Theme.Apersonalstuff.HomeMenuButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_gravity="fill"
                        android:gravity="center"
                        android:text="@string/title_add_item"
                        app:icon="@drawable/ic_post_add_black" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_add_item_usage"
                        style="@style/Theme.Apersonalstuff.HomeMenuButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_gravity="fill"
                        android:gravity="center"
                        android:text="@string/title_add_item_usage"
                        app:icon="@drawable/ic_playlist_add_black" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_add_item_purchase"
                        style="@style/Theme.Apersonalstuff.HomeMenuButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_gravity="fill"
                        android:gravity="center"
                        android:text="@string/title_add_item_purchase"
                        app:icon="@drawable/ic_playlist_add_black" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_add_item_maintenance"
                        style="@style/Theme.Apersonalstuff.HomeMenuButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_gravity="fill"
                        android:gravity="center"
                        android:text="@string/title_add_item_maintenance"
                        app:icon="@drawable/ic_playlist_add_black" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_add_item_reminder"
                        style="@style/Theme.Apersonalstuff.HomeMenuButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_gravity="fill"
                        android:gravity="center"
                        android:text="@string/title_add_item_reminder"
                        app:icon="@drawable/ic_add_alert_black" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_add_item_checklist"
                        style="@style/Theme.Apersonalstuff.HomeMenuButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_gravity="fill"
                        android:gravity="center"
                        android:text="@string/title_add_item_checklist"
                        app:icon="@drawable/ic_playlist_add_black" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_export"
                        style="@style/Theme.Apersonalstuff.HomeMenuButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_gravity="fill"
                        android:gravity="center"
                        android:text="@string/export_data"
                        app:icon="@drawable/ic_file_upload_black" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_import"
                        style="@style/Theme.Apersonalstuff.HomeMenuButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_gravity="fill"
                        android:gravity="center"
                        android:text="@string/import_data"
                        app:icon="@drawable/ic_file_download_black" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_export_spreadsheet"
                        style="@style/Theme.Apersonalstuff.HomeMenuButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_gravity="fill"
                        android:gravity="center"
                        android:text="@string/export_spreadsheet"
                        app:icon="@drawable/ic_table_black" />
                </GridLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/nav_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?attr/colorOnPrimary"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="?attr/colorSecondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/menu_items"
            style="@style/Theme.Apersonalstuff.BorderlessMenuButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_items"
            app:icon="@drawable/ic_list_alt_black" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/menu_item_checklists"
            style="@style/Theme.Apersonalstuff.BorderlessMenuButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_checklists"
            app:icon="@drawable/ic_checklist_black" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/menu_settings"
            style="@style/Theme.Apersonalstuff.BorderlessMenuButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings"
            app:icon="@drawable/ic_settings_black" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/menu_donation"
            style="@style/Theme.Apersonalstuff.BorderlessMenuButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/buy_developer_a_coffee"
            app:icon="@drawable/ic_coffee_black" />

    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.drawerlayout.widget.DrawerLayout>